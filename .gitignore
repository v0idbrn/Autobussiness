data/*
!data/denylist.yaml
backups/

# --- Logs & temporaries ---
*.log
logs/
*.tmp
*.bak
*.swp
*~

# --- Secrets / credentials ---
.env
.env.*
*.key
*.pem
secrets.yaml

# --- IDE / OS ---
.idea/
.vscode/
!.vscode/extensions.json
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

