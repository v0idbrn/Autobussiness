# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Packaging (EXE is not versioned; reproducible via build script) ---
build/
dist/
*.spec
!bam.spec
bam_exe_build/
*.manifest

# --- BAM runtime data (leads, evidence, jobs, runs, DB) ---
